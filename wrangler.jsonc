{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "library-membership-system",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["NOCODB_TOKEN"]
  },
  "observability": {
    "enabled": true
  }
}
